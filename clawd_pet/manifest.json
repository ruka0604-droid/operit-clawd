{
  "schema_version": 1,
  "toolpkg_id": "plush_heng",
  "version": "0.1.1",
  "api_version": "1.0.1",
  "main": "main.js",
  "author": [
    "Mishio & Claude"
  ],
  "display_name": {
    "zh": "毛绒阿衡·口袋版",
    "en": "Plush Heng Pocket"
  },
  "description": {
    "zh": "毛绒阿衡桌宠预览版：待机眨眼动画、悬浮、双击聊天与气泡。基于 ClawdPet，AGPL-3.0。请先停用原版桌宠再启用。",
    "en": "Plush Heng preview, based on ClawdPet (AGPL-3.0). Disable the original pet before enabling."
  },
  "enabled_by_default": false,
  "subpackages": [
    {
      "id": "plush_heng_control",
      "entry": "packages/clawd.js",
      "enabled_by_default": true,
      "display_name": {
        "zh": "毛绒阿衡控制",
        "en": "Plush Heng Control"
      },
      "description": {
        "zh": "让 Clawd 说话、播动作、贴边，以及管理设置与绑定对话",
        "en": "Speak, animate, dock, settings"
      }
    }
  ],
  "resources": [
    {
      "key": "clawd_host_dex",
      "path": "resources/native/clawd_host.dex",
      "mime": "application/vnd.android.dex"
    },
    {
      "key": "pet_html",
      "path": "assets/pet.html",
      "mime": "text/html"
    },
    {
      "key": "bubble_html",
      "path": "assets/bubble.html",
      "mime": "text/html"
    },
    {
      "key": "spr_ai_idle",
      "path": "sprites/ai_idle.png",
      "mime": "image/png"
    },
    {
      "key": "spr_json",
      "path": "sprites/sprites.json",
      "mime": "application/json"
    }
  ]
}
